{
  "name": "wordle-espanol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-payload.js",
    "prebuild": "node scripts/patch-payload.js",
    "dev": "next dev",
    "build": "node scripts/patch-payload.js && next build --webpack",
    "cf:build": "npx @opennextjs/cloudflare build && node scripts/prepare-cloudflare.js",
    "cf:preview": "npx @opennextjs/cloudflare build && npx @opennextjs/cloudflare preview",
    "cf:deploy": "npx @opennextjs/cloudflare build && npx @opennextjs/cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "generate:types": "payload generate:types"
  },
  "devDependencies": {
    "@types/node": "^18",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next-sitemap": "^4.2.3",
    "typescript": "~5.8.3",
    "wrangler": "^4"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.3",
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/graphql": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/ui": "^3.86.0",
    "graphql": "^16.14.2",
    "html2canvas": "^1.4.1",
    "next": "16.3.3",
    "node-cron": "^4.2.1",
    "payload": "^3.86.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "sharp": "^0.35.1",
    "styled-components": "^6.4.2"
  }
